[Unit]
Description=Lightweight Spotify playback engine for Omarchy Spotify
Documentation=https://github.com/Spotifyd/spotifyd
After=graphical-session.target sound.target
Wants=sound.target

[Service]
Type=simple
ExecStart=/usr/bin/spotifyd --no-daemon --config-path=%h/.config/omarchy-spotify/spotifyd.conf
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=null
StandardError=null
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
